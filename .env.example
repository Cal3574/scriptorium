# Copy to .env and fill in. Every variable the workspace reads lives here.
# .env is gitignored; .env.example is the single committed source of truth.

# --- Shared infrastructure (docker-compose defaults) ---
DATABASE_URL=postgres://scriptorium:scriptorium@localhost:5432/scriptorium
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# --- Provider mode (api + worker) ---
# fake = offline FakePdfExtractor / FakeEmbeddingClient / FakeLlmClient (free,
#        no network); live = LlamaParse / OpenAI / Claude. Defaults to `live`
#        when unset; local dev uses `fake`. All-or-nothing, no per-provider
#        override. The three keys below are required only when PROVIDER_MODE=live.
PROVIDER_MODE=fake
LLAMAPARSE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- api (loadApiConfig) ---
PORT=3000
API_URL=http://localhost:3000
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# PEM public key from the Clerk dashboard (API keys -> Show JWT public key).
# Enables networkless RSA verification in the auth guard.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----"
# The single browser origin allowed through CORS and accepted as the token
# `azp`. Never `*`.
CLIENT_ORIGIN=http://localhost:4200
# Reader-upload storage. Required only when PROVIDER_MODE=live; `fake` keeps
# uploads in an in-memory bucket. See docs/s3-setup.md for the one-time bucket
# CORS + scoped IAM setup.
S3_BUCKET=
S3_REGION=
# Set for an S3-compatible endpoint (MinIO, LocalStack); leave blank for AWS.
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Presigned-upload size ceiling enforced by POST /books/upload-url. Default 50 MiB.
MAX_UPLOAD_BYTES=52428800

# --- worker (loadWorkerConfig) ---
WORKER_PORT=3001
WORKER_CONCURRENCY=4
# The worker reads the original PDF back and writes the extracted-markdown
# blob, so in live mode it needs the same S3 config as the api. Reuse the
# api's S3_BUCKET / S3_REGION / S3_ENDPOINT / AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY values above.

# --- client (Vite, import.meta.env) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_API_URL=http://localhost:3000
