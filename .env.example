# Copy to .env and fill in. Every variable the workspace reads lives here.
# .env is gitignored; .env.example is the single committed source of truth.

# --- Shared infrastructure (docker-compose defaults) ---
DATABASE_URL=postgres://scriptorium:scriptorium@localhost:5432/scriptorium
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# --- Provider mode (api + worker) ---
# fake = offline FakePdfExtractor / FakeEmbeddingClient / FakeLlmClient (free,
#        no network); live = Gemini/LlamaParse / OpenAI / Claude. Defaults to
#        `live` when unset; local dev uses `fake`. All-or-nothing for the LLM
#        and embeddings; the PDF extractor is the one per-seam override (see
#        PDF_EXTRACTOR). OPENAI_API_KEY / ANTHROPIC_API_KEY are required when
#        PROVIDER_MODE=live.
PROVIDER_MODE=fake
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- PDF text extractor (api + worker) ---
# Which extractor the live bindings use: `gemini` (default) or `llamaparse`.
# `docling` (self-hosted) is planned. In live mode only the selected
# extractor's key is required.
PDF_EXTRACTOR=gemini
# Google AI Studio API key. Required when PROVIDER_MODE=live and
# PDF_EXTRACTOR=gemini.
GEMINI_API_KEY=
# Optional Gemini tuning (defaults shown). GEMINI_MODEL can step up to a larger
# Flash-Lite tier if extraction quality is borderline.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_PAGES_PER_BATCH=10
GEMINI_BATCH_CONCURRENCY=5
# Required when PROVIDER_MODE=live and PDF_EXTRACTOR=llamaparse.
LLAMAPARSE_API_KEY=

# --- api (loadApiConfig) ---
PORT=3000
API_URL=http://localhost:3000
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# PEM public key from the Clerk dashboard (API keys -> Show JWT public key).
# Enables networkless RSA verification in the auth guard. Keep it as real line
# breaks inside the quotes (not \n escapes) - scripts/dev.sh sources this file
# with plain `bash . ./.env`, which does not expand \n in double-quoted
# values, so an escaped PEM here silently becomes a malformed key at runtime.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----
replace_me
-----END PUBLIC KEY-----"
# The single browser origin allowed through CORS and accepted as the token
# `azp`. Never `*`.
CLIENT_ORIGIN=http://localhost:4200
# Reader-upload storage. Required only when PROVIDER_MODE=live; `fake` keeps
# uploads in an in-memory bucket. See docs/s3-setup.md for the one-time bucket
# CORS + scoped IAM setup.
S3_BUCKET=
S3_REGION=
# Set for an S3-compatible endpoint (MinIO, LocalStack); leave blank for AWS.
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Presigned-upload size ceiling enforced by POST /books/upload-url. Default 50 MiB.
MAX_UPLOAD_BYTES=52428800
# Cross-book RAG query tuning (POST /queries). All optional - the spec defaults
# below apply when unset. See docs/wayfinder/rag-query-spec.md.
RAG_HNSW_EF_SEARCH=100
RAG_CANDIDATE_POOL=50
RAG_TOP_K=12
RAG_MAX_PER_BOOK=6
RAG_MIN_SIMILARITY=0.25
RAG_MIN_RESULTS=3
RAG_LOWCONF_K=4

# --- worker (loadWorkerConfig) ---
WORKER_PORT=3001
WORKER_CONCURRENCY=4
# The worker reads the original PDF back and writes the extracted-markdown
# blob, so in live mode it needs the same S3 config as the api. Reuse the
# api's S3_BUCKET / S3_REGION / S3_ENDPOINT / AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY values above.

# --- client (Vite, import.meta.env) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_API_URL=http://localhost:3000
