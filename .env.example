# Copy to .env and fill in. Every variable the workspace reads lives here.
# .env is gitignored; .env.example is the single committed source of truth.

# --- Shared infrastructure (docker-compose defaults) ---
DATABASE_URL=postgres://scriptorium:scriptorium@localhost:5432/scriptorium
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# --- Provider mode (api + worker) ---
# fake = offline FakePdfExtractor / FakeEmbeddingClient / FakeLlmClient (free,
#        no network); live = LlamaParse / OpenAI / Claude. Defaults to `live`
#        when unset; local dev uses `fake`. All-or-nothing, no per-provider
#        override. The three keys below are required only when PROVIDER_MODE=live.
PROVIDER_MODE=fake
LLAMAPARSE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- api (loadApiConfig) ---
PORT=3000
API_URL=http://localhost:3000
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# PEM public key from the Clerk dashboard (API keys -> Show JWT public key).
# Enables networkless RSA verification in the auth guard.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----"
# The single browser origin allowed through CORS and accepted as the token
# `azp`. Never `*`.
CLIENT_ORIGIN=http://localhost:4200

# --- worker (loadWorkerConfig) ---
WORKER_PORT=3001
WORKER_CONCURRENCY=4
STORAGE_BUCKET_URL=http://localhost:9000/scriptorium

# --- client (Vite, import.meta.env) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_API_URL=http://localhost:3000
