{
  "name": "@scriptorium/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "database",
    "tags": [
      "type:lib",
      "scope:database"
    ],
    "targets": {
      "generate": {
        "command": "drizzle-kit generate",
        "options": {
          "cwd": "packages/database"
        }
      },
      "check": {
        "command": "drizzle-kit check",
        "options": {
          "cwd": "packages/database"
        }
      },
      "migrate": {
        "command": "node scripts/migrate.mjs",
        "options": {
          "cwd": "packages/database"
        }
      },
      "seed": {
        "command": "node scripts/seed.mjs",
        "dependsOn": [
          "migrate"
        ],
        "options": {
          "cwd": "packages/database"
        }
      },
      "test-integration": {
        "executor": "@nx/jest:jest",
        "options": {
          "jestConfig": "packages/database/jest.integration.config.cts",
          "runInBand": true
        }
      }
    }
  },
  "bin": {
    "scriptorium-migrate": "./scripts/migrate.mjs"
  },
  "dependencies": {
    "@scriptorium/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@swc-node/register": "1.11.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
