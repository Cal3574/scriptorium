{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "jest.config.cts",
    "jest.integration.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.integration-spec.ts",
    "src/test-support/**",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    { "path": "../config/tsconfig.lib.json" },
    { "path": "../contracts/tsconfig.lib.json" },
    { "path": "../database/tsconfig.lib.json" },
    { "path": "../providers/tsconfig.lib.json" },
    { "path": "../server-core/tsconfig.lib.json" }
  ]
}
