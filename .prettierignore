# Add files here to ignore them from prettier formatting
/dist
/coverage
/.nx/cache
/.nx/workspace-data
.nx/self-healing

# SWC runtime config - prettier cannot infer a parser for the .swcrc extension
# and errors the whole `nx format:check` run when it is included.
*.swcrc
# Drizzle-generated migration bookkeeping - owned by drizzle-kit, not prettier.
/packages/database/migrations
# Machine-generated by `kustomize edit set image` in the Release workflow
# (.github/workflows/release.yml) - kustomize owns its formatting, not prettier.
/k8s/kustomization.yaml
